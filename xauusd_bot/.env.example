# ---- TradeLocker (never commit the real .env) ----
TRADELOCKER_ENV=demo
TRADELOCKER_USERNAME=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=

# ---- Safety ----
LIVE_TRADING=false
INITIAL_EQUITY=500

# ---- Risk ----
RISK_PERCENT=0.50
MAX_DAILY_LOSS_PERCENT=1.50
MAX_WEEKLY_LOSS_PERCENT=4.00
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_TRADES=5

# ---- Execution limits (price units, i.e. USD per ounce) ----
MAX_SPREAD=0.60
MAX_SLIPPAGE=0.60

# ---- Broker contract spec. On a standard XAUUSD contract MIN_LOT is 0.01,
# which cannot be risked at 0.5% on a $500 account. Micro accounts allow 0.001.
# The bot reads the real values from the broker at startup and overrides these.
MIN_LOT=0.01
LOT_STEP=0.01

# ---- Strategy toggles ----
TREND_CONTINUATION=true
LIQUIDITY_REVERSAL=true
BREAKOUT=true

# ---- Optional alerting ----
TG_BOT_TOKEN=
TG_CHAT_ID=
