//@version=5
// ════════════════════════════════════════════════════════════════════════
//  INTRADAY ORB STRATEGY  v1.0  — TradingView port of intraday_strategy.py
//  Opening Range Breakout: session-bound, same-day, no overnight risk.
//  This is the FOREX version — the price_action_strategy.pine script
//  (swing, 4H/1H, EMA-pullback) is for SPX500/US30/NAS100/XAUUSD and does
//  NOT carry an edge on FX pairs. This ORB script is the one that does.
//
//  Plots a BUY/SELL label at every breakout entry and draws the opening
//  range as a box so you can see the setup forming in real time.
//
//  ── HOW TO USE ──────────────────────────────────────────────────────
//  1. Apply to the 5-MINUTE chart of one of the pairs below.
//  2. Leave parameters on default — these are the exact locked values
//     from intraday_strategy.py, tested identically on every pair (no
//     per-pair tuning, which is what makes the result trustworthy).
//  3. Times are UTC. Check your chart's timezone setting if signals look
//     off by a few hours.
//
//  ── VALIDATION STATUS (2026-07-14) — read before trusting this ───────
//  PRIMARY (trade)   EURUSD, AUDUSD, GBPAUD, USDCHF
//                    split-half consistent, PF 1.2-1.8 both halves
//  WATCH (half size) NZDUSD, XAUUSD — real in the first half of the test
//                    window, fades hard in the second half
//  BANNED            USDCAD, USDJPY, GBPCAD, NZDJPY, GBPJPY, EURGBP —
//                    unstable or losing in BOTH halves. Do not run this
//                    on them expecting different results.
//
//  THIS IS THINNER EVIDENCE than the swing strategy: only 60 days of
//  5-minute data exists (Yahoo Finance's hard ceiling for that interval),
//  one volatility regime, no true multi-year held-out test. Re-validate
//  WEEKLY, not monthly, against this repo's own numbers. TWAP mean-
//  reversion was also tested and lost on every single pair — this ORB
//  version is the only one worth running.
// ════════════════════════════════════════════════════════════════════════
strategy("Intraday ORB Strategy (FX, Locked)",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 100,
     commission_type      = strategy.commission.cash_per_order,
     commission_value     = 0.0,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     max_labels_count     = 500,
     max_lines_count      = 500,
     max_boxes_count      = 200)

// ─── INPUTS (locked defaults — see header table before changing) ────────
grpSess    = "── Sessions (UTC) ──"
londonStart= input.int(7,  "London Start", minval=0, maxval=23, group=grpSess)
londonEnd  = input.int(10, "London End",   minval=0, maxval=23, group=grpSess)
nyStart    = input.int(12, "NY Start",     minval=0, maxval=23, group=grpSess)
nyEnd      = input.int(15, "NY End",       minval=0, maxval=23, group=grpSess)

grpORB     = "── Opening Range Breakout (locked shape) ──"
orbMinutes    = input.int(30, "Opening Range Window (minutes)", group=grpORB)
breakoutMins  = input.int(60, "Breakout Follow-Through Window (minutes)", group=grpORB)
sessionEndMins= input.int(180,"Flatten By (minutes after session open)", group=grpORB)
targetR       = input.float(1.5, "Target (R multiple, single target)", group=grpORB)
stopBufferATR = input.float(0.15, "Stop Buffer (×ATR)", group=grpORB)
atrLen        = input.int(14, "ATR Length", group=grpORB)
fillWindowBars= input.int(3, "Entry Fill Window (bars)", group=grpORB)
riskPct       = input.float(1.0, "Risk % per Trade", minval=0.1, maxval=5, step=0.1, group=grpORB)

grpViz     = "── Visuals ──"
showBox    = input.bool(true, "Show Opening Range Box", group=grpViz)
showLabels = input.bool(true, "Show Entry Labels", group=grpViz)

// ─── BAR SIZE / WINDOW CONVERSION (assumes chart TF divides evenly) ─────
barMinutes    = timeframe.in_seconds(timeframe.period) / 60
orbBars       = int(math.max(1, math.round(orbMinutes / barMinutes)))
breakoutBars  = int(math.max(1, math.round(breakoutMins / barMinutes)))
sessionEndBars= int(math.max(1, math.round(sessionEndMins / barMinutes)))

// ─── SESSION DETECTION (UTC hour based, matches tag_sessions() in Python) ─
utcHour = hour(time, "UTC")
inLondon = utcHour >= londonStart and utcHour < londonEnd
inNY     = utcHour >= nyStart and utcHour < nyEnd
inSession = inLondon or inNY

var int sessionOpenBar = na
var bool sessionTraded = false
newSession = inSession and not inSession[1]
if newSession
    sessionOpenBar := bar_index
    sessionTraded := false
if not inSession
    sessionOpenBar := na

atr = ta.atr(atrLen)

// ─── OPENING RANGE (first orbBars of each session) ───────────────────────
var float rangeHigh = na
var float rangeLow  = na
inRangeWindow = not na(sessionOpenBar) and (bar_index - sessionOpenBar) < orbBars
if newSession
    rangeHigh := high
    rangeLow  := low
else if inRangeWindow
    rangeHigh := math.max(rangeHigh, high)
    rangeLow  := math.min(rangeLow, low)

rangeJustClosed = not na(sessionOpenBar) and (bar_index - sessionOpenBar) == orbBars
inBreakoutWindow = not na(sessionOpenBar) and (bar_index - sessionOpenBar) >= orbBars and
     (bar_index - sessionOpenBar) < orbBars + breakoutBars

// draw the opening range box once it's formed
var box orbBox = na
if rangeJustClosed and showBox
    box.delete(orbBox)
    orbBox := box.new(sessionOpenBar, rangeHigh, bar_index, rangeLow,
         border_color=color.new(color.blue, 40), bgcolor=color.new(color.blue, 90))
if not na(orbBox) and inBreakoutWindow
    box.set_right(orbBox, bar_index)

// ─── SIGNAL: close beyond the opening range within the breakout window ──
rangeValid = not na(rangeHigh) and not na(rangeLow) and (rangeHigh - rangeLow) > 0
longSignal  = inBreakoutWindow and rangeValid and not sessionTraded and close > rangeHigh
shortSignal = inBreakoutWindow and rangeValid and not sessionTraded and close < rangeLow

plotshape(longSignal,  title="BUY signal",  style=shape.triangleup,   location=location.belowbar,
     color=color.new(color.lime, 0), size=size.small, text="BUY")
plotshape(shortSignal, title="SELL signal", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="SELL")

// ─── ENTRY / STOP / TARGET (matches simulate_single_target() in Python) ──
var float pendingEntry = na
var float pendingStop  = na
var int   pendingDir   = 0
var int   pendingBar   = na
var int   pendingDeadline = na  // sessionOpenBar + sessionEndBars, both int -> int, safe

if longSignal and strategy.position_size == 0 and na(pendingEntry)
    pendingEntry := rangeHigh + syminfo.mintick
    pendingStop  := rangeLow - stopBufferATR * atr
    pendingDir   := 1
    pendingBar   := bar_index
    pendingDeadline := sessionOpenBar + sessionEndBars
    sessionTraded := true

if shortSignal and strategy.position_size == 0 and na(pendingEntry)
    pendingEntry := rangeLow - syminfo.mintick
    pendingStop  := rangeHigh + stopBufferATR * atr
    pendingDir   := -1
    pendingBar   := bar_index
    pendingDeadline := sessionOpenBar + sessionEndBars
    sessionTraded := true

if not na(pendingBar) and strategy.position_size == 0 and (bar_index - pendingBar) > fillWindowBars
    strategy.cancel("Long")
    strategy.cancel("Short")
    pendingEntry := na
    pendingStop  := na
    pendingDir   := 0
    pendingBar   := na

float riskUnit = na(pendingEntry) ? na(float) : math.abs(pendingEntry - pendingStop)
float qty = na(riskUnit) or riskUnit <= 0 ? na(float) : (strategy.equity * riskPct / 100) / riskUnit

if pendingDir == 1 and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=qty, stop=pendingEntry)
if pendingDir == -1 and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=qty, stop=pendingEntry)

var float entryPrice = na
var float slPrice    = na
var float tgtPrice   = na
var int   deadlineBar= na

if strategy.position_size != 0 and na(entryPrice)
    entryPrice := strategy.position_avg_price
    slPrice    := pendingStop
    dir         = strategy.position_size > 0 ? 1 : -1
    tgtPrice   := entryPrice + dir * targetR * riskUnit
    deadlineBar:= pendingDeadline
    pendingEntry := na
    pendingStop  := na
    pendingDir   := 0
    pendingBar   := na

if strategy.position_size != 0
    strategy.exit("Target", from_entry=strategy.position_size > 0 ? "Long" : "Short",
         limit=tgtPrice, stop=slPrice)
    if not na(deadlineBar) and bar_index >= deadlineBar
        strategy.close_all(comment="session-end")

if strategy.position_size == 0
    entryPrice := na
    slPrice    := na
    tgtPrice   := na
    deadlineBar:= na

// ─── LABELS ───────────────────────────────────────────────────────────────
if showLabels and (longSignal or shortSignal)
    label.new(bar_index, longSignal ? low - atr : high + atr,
         longSignal ? "BUY\nORB " + str.tostring(math.round(rangeHigh, 5)) : "SELL\nORB " + str.tostring(math.round(rangeLow, 5)),
         style=longSignal ? label.style_label_up : label.style_label_down,
         color=longSignal ? color.new(color.lime, 20) : color.new(color.red, 20),
         textcolor=color.white, size=size.small)

// ─── DASHBOARD ─────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Session",  text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(dash, 1, 0, inLondon ? "LONDON" : inNY ? "NY" : "closed",
         text_color=inSession ? color.lime : color.gray)
    totTrades = strategy.closedtrades
    winTrades = strategy.wintrades
    wr = totTrades > 0 ? (winTrades / totTrades) * 100 : 0
    table.cell(dash, 0, 1, "Win Rate", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(dash, 1, 1, str.tostring(math.round(wr, 1)) + "%", text_color=color.white)
    pf = strategy.grossprofit / (strategy.grossloss == 0 ? 1 : strategy.grossloss)
    table.cell(dash, 0, 2, "Profit Factor", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(dash, 1, 2, str.tostring(math.round(pf, 2)), text_color=color.white)
