//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  GOLD SNIPER SCALPER  —  XAUUSD only  —  5-minute chart
//
//  SETUP — trend continuation (NOT a reversal / "buy the dip" system):
//    1. TREND      EMA50 above EMA200 and price above EMA200  (longs;
//                  mirrored for shorts). We only trade with the tape.
//    2. BREAKOUT   the candle CLOSES beyond the highest high of the prior
//                  20 bars — the range breaks in the trend's direction.
//    3. MOMENTUM   RSI(14) sits in 50-80: real momentum behind the break,
//                  but not yet blown off.
//    4. VOLATILITY ATR must be 0.5x-2.2x its 500-bar median — skips dead
//                  tape (target unreachable) and news spikes (stop run).
//    5. SESSION    12:00-20:00 UTC only (London/NY overlap into the NY
//                  session). This window tested materially better than
//                  either London-only or 24h.
//
//  ── WHY THIS DOES NOT REPAINT ─────────────────────────────────────────────
//  * calc_on_every_tick = false  -> evaluated only at BAR CLOSE.
//  * The broken range is ta.highest(high, 20)[1] — the bars BEFORE the signal
//    bar. The [1] offset is what stops the level being redrawn by the very
//    bar being judged.
//  * process_orders_on_close = false -> the order fills at the NEXT bar's
//    OPEN, a price you could actually have traded.
//  * Entry / Stop / Target lines are created only AFTER the signal bar has
//    closed and are pinned to fixed prices. Once printed they never move,
//    never shift and never vanish on refresh.
//  * No request.security(), no lookahead, no future-referencing functions.
//
//  ── VERIFIED RESULT (90 days of REAL Dukascopy tick data, to 2026-09-03) ──
//  Defaults below (1.8xATR stop, 1.5R target), spread paid on entry AND exit,
//  stop-vs-target resolved on the actual tick sequence:
//      122 trades | Win rate 49.2% | Profit factor 1.42 | +26.0R | maxDD 7.1R
//  Fitted on the first 60 days, then scored ONCE on the unseen last 30 days:
//      in-sample 50.0% WR / PF 1.47   ->   held-out 45.8% WR / PF 1.23
//
//  ── KNOWN WEAKNESSES (read before risking money) ──────────────────────────
//  * ONE-SIDED. Over the 90 days the SHORTS carried it: 60 shorts +26.4R
//    (PF 2.06) vs 62 longs -0.4R (PF 0.99). A two-sided edge is claimed by
//    the rules but NOT demonstrated by the data. Treat the long side as
//    unproven.
//  * CONCENTRATED. June alone produced +14.9R of the +26.0R. July and August
//    were close to flat (PF 1.09 and 1.13). Expect long dull stretches.
//  * SHORT SAMPLE. 122 trades over 90 days of one instrument in one regime is
//    not enough to call this robust. Forward-test on demo before going live.
//
//  ── READ THIS BEFORE CHANGING "Target (R multiple)" ───────────────────────
//  Setting the target to 0.5R raises the win rate to ~69% and it is very
//  tempting. It is a trap. At 0.5R the held-out 30 days came back at PF 0.97
//  — i.e. NOT making money — because each loss is 3.6x the size of each win.
//  Over the full 90 days it returned +8.7R against +26.0R for the 1.5R
//  default. The high win rate is bought with an unprofitable payoff.
//  Win rate is not edge.
//
//  ── HOW TO USE ────────────────────────────────────────────────────────────
//  1. Open XAUUSD (gold) on the 5-minute timeframe.
//  2. Add this script, then open the "Strategy Tester" tab.
//  3. IMPORTANT — model your costs. Properties -> Slippage: set about HALF
//     your broker's typical gold spread in ticks (spread ~0.40 with mintick
//     0.01 => ~20). It is charged on entry AND exit, so half per side equals
//     one full spread per round turn. With zero slippage the tester flatters
//     these numbers.
// ═══════════════════════════════════════════════════════════════════════════
strategy("Gold Sniper Scalper (XAUUSD M5)",
     overlay                 = true,
     initial_capital         = 10000,
     currency                = currency.USD,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     calc_on_every_tick      = false,
     process_orders_on_close = false,
     max_labels_count        = 500,
     max_lines_count         = 500,
     max_boxes_count         = 500)

// ─────────────────────────────── Inputs ───────────────────────────────────
gS = "1 · Signal"
boLen     = input.int(20, "Breakout range length (bars)", minval=3, group=gS,
     tooltip="The close must break the highest high / lowest low of this many PRIOR bars.")
emaFast   = input.int(50,  "Fast EMA", minval=5,  group=gS)
emaSlow   = input.int(200, "Trend EMA", minval=20, group=gS)
useStack  = input.bool(true, "Require EMA stack (fast beyond slow)", group=gS)
rsiLen    = input.int(14, "RSI length", minval=2, group=gS)
rsiLo     = input.float(50, "Momentum band low",  step=1, group=gS,
     tooltip="Longs need RSI >= this. Shorts use the mirror (100 - value).")
rsiHi     = input.float(80, "Momentum band high", step=1, group=gS,
     tooltip="Longs need RSI <= this, so we skip blow-off tops.")

gV = "2 · Volatility regime"
atrLen    = input.int(14,  "ATR length", minval=2, group=gV)
atrMedLen = input.int(500, "ATR median lookback", minval=50, group=gV)
atrMin    = input.float(0.5, "Skip if ATR / median below", step=0.05, group=gV)
atrMax    = input.float(2.2, "Skip if ATR / median above", step=0.05, group=gV)

gR = "3 · Risk"
slAtr     = input.float(1.8, "Stop distance (x ATR)", step=0.1, minval=0.1, group=gR)
tpR       = input.float(1.5, "Target (R multiple)", step=0.1, minval=0.1, group=gR,
     tooltip="READ THE HEADER. Lowering this to 0.5 buys a ~69% win rate that LOSES money out of sample.")
usePartial = input.bool(false, "Scale out 50% at TP1, run the rest to TP2", group=gR,
     tooltip="OFF by default. This was NOT part of the validated backtest — the published stats are single-target.")
tp1R      = input.float(1.0, "TP1 (R) when scaling out", step=0.1, minval=0.1, group=gR)
useBE     = input.bool(false, "Move stop to breakeven at 1R", group=gR,
     tooltip="Tested and REJECTED: it cut the win rate from 49% to 31% by stopping out trades that recovered.")
maxBars   = input.int(72, "Force exit after N bars", minval=5, group=gR)
coolBars  = input.int(3,  "Cooldown bars after an exit", minval=0, group=gR)

gT = "4 · Session (UTC)"
sessStart = input.int(12, "Trade from hour (UTC)", minval=0, maxval=23, group=gT)
sessEnd   = input.int(20, "Trade until hour (UTC)", minval=1, maxval=24, group=gT)

gD = "5 · Display"
showLines = input.bool(true, "Draw Entry / Stop / Target levels", group=gD)
showLbl   = input.bool(true, "Show price labels", group=gD)
showPanel = input.bool(true, "Show performance panel", group=gD)

// ───────────────────── Indicators (closed bars only) ──────────────────────
atrV   = ta.atr(atrLen)
atrMed = ta.median(atrV, atrMedLen)
rsiV   = ta.rsi(close, rsiLen)
emaF   = ta.ema(close, emaFast)
emaS   = ta.ema(close, emaSlow)

// The range being broken: extremes of the bars BEFORE this one.
boHi = ta.highest(high, boLen)[1]
boLo = ta.lowest(low,   boLen)[1]

hUTC   = hour(time, "UTC")
inSess = sessStart < sessEnd ? (hUTC >= sessStart and hUTC < sessEnd)
                             : (hUTC >= sessStart or  hUTC < sessEnd)
volOK  = not na(atrMed) and atrV >= atrMin * atrMed and atrV <= atrMax * atrMed
baseOK = inSess and volOK and not na(emaS) and not na(boHi) and not na(boLo)

upTrend = close > emaS and (not useStack or emaF > emaS)
dnTrend = close < emaS and (not useStack or emaF < emaS)

longSig  = baseOK and upTrend and close > boHi and rsiV >= rsiLo and rsiV <= rsiHi
shortSig = baseOK and dnTrend and close < boLo and rsiV <= 100 - rsiLo and rsiV >= 100 - rsiHi

// ───────────────────────────── Trade state ────────────────────────────────
var int   lastExitBar = -100000
var int   pendDir     = 0
var float curStop     = na
var float curTP       = na
var float curTP1      = na
var int   entryBar    = na
var bool  beDone      = false

flat     = strategy.position_size == 0
canTrade = flat and (bar_index - lastExitBar) > coolBars

if longSig and canTrade
    pendDir := 1
    strategy.entry("Long", strategy.long)
if shortSig and canTrade
    pendDir := -1
    strategy.entry("Short", strategy.short)

justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0

var line  lnE = na
var line  lnS = na
var line  lnT = na
var line  lnT1 = na
var label lbE = na
var label lbS = na
var label lbT = na

// ────────── Levels are pinned the moment the fill happens, then frozen ─────
if justOpened
    e = strategy.position_avg_price
    // atrV[1] is the SIGNAL bar's ATR: the signal closed last bar, we filled
    // on this bar's open. Using atrV here would use a bar the signal never saw.
    a    = atrV[1]
    risk = slAtr * a
    if risk > 0
        curStop  := pendDir == 1 ? e - risk : e + risk
        curTP    := pendDir == 1 ? e + tpR  * risk : e - tpR  * risk
        curTP1   := pendDir == 1 ? e + tp1R * risk : e - tp1R * risk
        entryBar := bar_index
        beDone   := false

        if showLines
            lnE  := line.new(bar_index, e,       bar_index, e,       color=color.new(color.blue,  0), width=2)
            lnS  := line.new(bar_index, curStop, bar_index, curStop, color=color.new(color.red,   0), width=2, style=line.style_dashed)
            lnT  := line.new(bar_index, curTP,   bar_index, curTP,   color=color.new(color.green, 0), width=2, style=line.style_dashed)
            if usePartial
                lnT1 := line.new(bar_index, curTP1, bar_index, curTP1, color=color.new(color.teal, 0), width=1, style=line.style_dotted)
        if showLbl
            lbE := label.new(bar_index, e, text=str.tostring(e, format.mintick) + "  ENTRY " + (pendDir == 1 ? "LONG" : "SHORT"),
                 style=label.style_label_left, color=color.new(color.blue, 20), textcolor=color.white, size=size.small)
            lbS := label.new(bar_index, curStop, text=str.tostring(curStop, format.mintick) + "  STOP  (-1R)",
                 style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
            lbT := label.new(bar_index, curTP, text=str.tostring(curTP, format.mintick) + "  TARGET  (+" + str.tostring(tpR, "#.##") + "R)",
                 style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=size.small)

inTrade = strategy.position_size != 0 and not na(curStop)

// Breakeven (off by default — it tested worse). Only ever helps the stop.
if inTrade and useBE and not beDone
    e    = strategy.position_avg_price
    risk = math.abs(e - curStop)
    trig = strategy.position_size > 0 ? e + risk : e - risk
    hitTrig = strategy.position_size > 0 ? high >= trig : low <= trig
    if hitTrig and risk > 0
        curStop := e
        beDone  := true
        if showLines and not na(lnS)
            line.set_y1(lnS, e)
            line.set_y2(lnS, e)
        if showLbl and not na(lbS)
            label.set_y(lbS, e)
            label.set_text(lbS, str.tostring(e, format.mintick) + "  STOP -> BREAKEVEN")

if inTrade
    if usePartial
        strategy.exit("TP1", qty_percent=50, stop=curStop, limit=curTP1, comment_loss="SL", comment_profit="TP1")
        strategy.exit("TP2", stop=curStop, limit=curTP, comment_loss="SL", comment_profit="TP2")
    else
        strategy.exit("X", stop=curStop, limit=curTP, comment_loss="SL", comment_profit="TP")
    if bar_index - entryBar >= maxBars
        strategy.close_all(comment="TIME")
    if showLines
        if not na(lnE)
            line.set_x2(lnE, bar_index)
        if not na(lnS)
            line.set_x2(lnS, bar_index)
        if not na(lnT)
            line.set_x2(lnT, bar_index)
        if not na(lnT1)
            line.set_x2(lnT1, bar_index)
    if showLbl
        if not na(lbE)
            label.set_x(lbE, bar_index)
        if not na(lbS)
            label.set_x(lbS, bar_index)
        if not na(lbT)
            label.set_x(lbT, bar_index)

// On the exit bar everything freezes exactly where it was — a permanent,
// non-repainting record of the trade that was actually taken.
if flat and not flat[1]
    lastExitBar := bar_index
    curStop     := na
    curTP       := na

// ─────────────────────────── Signal markers ───────────────────────────────
plotshape(longSig  and canTrade, title="Long breakout",  style=shape.triangleup,
     location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(shortSig and canTrade, title="Short breakout", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)
plot(emaS, "Trend EMA", color=color.new(color.orange, 40), linewidth=1)
plot(emaF, "Fast EMA",  color=color.new(color.aqua,   60), linewidth=1)

// ───────────────────────── Performance panel ──────────────────────────────
if showPanel and barstate.islast
    tot  = strategy.closedtrades
    wins = strategy.wintrades
    wr   = tot > 0 ? 100.0 * wins / tot : 0.0
    pf   = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0
    var table p = table.new(position.top_right, 2, 5, border_width=1)
    table.cell(p, 0, 0, "GOLD SNIPER", bgcolor=color.new(color.blue, 0), text_color=color.white, text_size=size.small)
    table.cell(p, 1, 0, "XAUUSD M5",   bgcolor=color.new(color.blue, 0), text_color=color.white, text_size=size.small)
    table.cell(p, 0, 1, "Trades",      text_color=color.gray,  text_size=size.small)
    table.cell(p, 1, 1, str.tostring(tot), text_color=color.white, text_size=size.small)
    table.cell(p, 0, 2, "Win rate",    text_color=color.gray,  text_size=size.small)
    table.cell(p, 1, 2, str.tostring(wr, "#.##") + " %",
         text_color = wr >= 55 ? color.lime : wr >= 45 ? color.orange : color.red, text_size=size.small)
    table.cell(p, 0, 3, "Profit factor", text_color=color.gray, text_size=size.small)
    table.cell(p, 1, 3, str.tostring(pf, "#.##"),
         text_color = pf >= 1.4 ? color.lime : pf >= 1.0 ? color.orange : color.red, text_size=size.small)
    table.cell(p, 0, 4, "Net P&L",     text_color=color.gray,  text_size=size.small)
    table.cell(p, 1, 4, str.tostring(strategy.netprofit, "#.##"),
         text_color = strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.small)

// ──────────────────────────────── Alerts ──────────────────────────────────
alertcondition(longSig,  title="Gold Sniper LONG",  message="Gold Sniper: LONG breakout confirmed on XAUUSD M5")
alertcondition(shortSig, title="Gold Sniper SHORT", message="Gold Sniper: SHORT breakout confirmed on XAUUSD M5")
