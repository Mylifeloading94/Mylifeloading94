# Third-party MCP clone (install locally on your own machine, do not vendor)
tradingview-mcp/

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo

# Secrets / credentials — never commit
.env
*.key
*.pem

# Container-specific MCP config (paths differ per machine)
.mcp.json

# Runtime state (changes every autopilot iteration — not source)
agent_state.json
active_trades.json

# OS / editor
.DS_Store

# Bot runtime results (regenerated)
hp_bot_backtest_results.json

# Cached price data (regenerable, large)
data/

# XAUUSD SMC engine runtime state.
# state/stats.json and state/backtest_trades.json ARE committed — they are the
# validated statistics the bot is allowed to quote. Everything else is runtime.
state/cache/
state/signals.jsonl
state/news.json
xauusd_dashboard.html
xausmc.config.json
