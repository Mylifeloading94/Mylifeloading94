# Third-party MCP clone (install locally on your own machine, do not vendor)
tradingview-mcp/

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo

# Secrets / credentials — never commit
.env
*.key
*.pem

# Container-specific MCP config (paths differ per machine)
.mcp.json

# Runtime state (changes every autopilot iteration — not source)
agent_state.json
active_trades.json

# OS / editor
.DS_Store

# Bot runtime results (regenerated)
hp_bot_backtest_results.json

# Cached price data (regenerable, large)
data/

# Live bot runtime state
live_state.json

# Backtest outputs (regenerated by run_backtest.py)
backtest_results.json
trades_oos_2026.csv

# v2 backtest outputs (regenerated)
final_results.json
trades_walkforward.csv

# SMC study outputs (regenerated)
smc_insample.csv

# XAUUSD research scratch
xau/__pycache__/

# Sniper 87 backtest outputs (regenerated)
smc_trades_*.csv
smc_equity_*.csv
smc_all_windows.csv
