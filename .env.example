# ---------------------------------------------------------------------------
# XAUUSD SMC bot — copy to .env and fill in. .env is gitignored; never commit it.
# ---------------------------------------------------------------------------

# --- TradeLocker ---
TL_ENV=demo                 # demo | live   (start on demo)
TL_EMAIL=you@example.com
TL_PASSWORD=your-password
TL_SERVER=YOUR-SERVER       # e.g. OSP-DEMO / GenFX — shown on the TradeLocker login screen
TL_ACCOUNT_ID=              # optional; blank = first account on the login
# Required only when TL_ENV=live — the bot refuses live trading without it:
# TL_CONFIRM_LIVE=I_UNDERSTAND

# --- Telegram ---
TG_BOT_TOKEN=123456:ABC-your-bot-token
TG_CHAT_ID=-1001234567890   # channel id (add the bot as an admin of the channel)

# --- Behaviour (all optional; defaults shown) ---
SYMBOL=XAUUSD
SCAN_SECONDS=60
DRY_RUN=false
MIN_GRADE=A                 # A+ | A | B  — B is the doc's low-conviction grade
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=2
DAILY_LOSS_PCT=0.06
WEEKLY_LOSS_PCT=0.10
MAX_LOTS=10
MAX_SPREAD_USD=0.50
MIN_ATR_PIPS=1.5
SESSION_ONLY=true
NEWS_BUFFER_MIN=15
NEWS_FALLBACK_BLACKOUT=true
# NEWS_JSON_URL=https://example.com/high-impact.json
SL_BUFFER_PIPS=2.5
SL_ATR_MULT=0.25
TP1_R=2.0
TP2_R=3.0
MIN_RR=2.0
MAX_CHASE_R=0.5
