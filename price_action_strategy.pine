//@version=5
// ════════════════════════════════════════════════════════════════════════
//  PRICE ACTION STRATEGY  v1.0  — TradingView port of price_action_strategy.py
//  Trend-Pullback Price Action: 4H trend filter + 1H EMA20 pullback +
//  pin-bar/engulfing rejection + momentum-break entry.
//
//  Plots a BUY/SELL label on the chart at every signal bar and draws
//  Entry/SL/TP1/TP2 levels once a trade is taken. Built as a strategy()
//  so the Strategy Tester tab gives you a second, independent read on the
//  same numbers already validated in Python — open it to compare.
//
//  ── HOW TO USE ──────────────────────────────────────────────────────
//  1. Apply to the 1H chart of one of the LOCKED instruments below.
//  2. Set "Wick Ratio" to the locked value for that instrument (see table).
//  3. Leave everything else on its default — these are the exact locked
//     parameters from price_action_strategy.py, not free knobs to tune.
//
//  ── LOCKED STATUS (2026-07-14, from the Python backtest) ─────────────
//  PRIMARY   SPX500, US30     wick=0.70   full risk   ~60% WR / PF 3.4 OOS
//  SECONDARY NAS100           wick=0.60   half risk   PF ~1.2-1.8
//  TERTIARY  XAUUSD           wick=0.75   quarter risk PF ~1.15-1.40, fragile
//  BANNED    all other FX pairs — confirmed no edge across 4 independent
//            attempts. Do not run this on them expecting different results.
//
//  Data source difference: the Python backtest runs on Yahoo Finance
//  hourly bars; this runs on TradingView's own feed for the symbol you
//  apply it to. Expect small differences in exact fills — same caveat
//  already documented for the live TradeLocker execution in this repo.
// ════════════════════════════════════════════════════════════════════════
strategy("Lazy Signal V1",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 100,
     commission_type      = strategy.commission.cash_per_order,
     commission_value     = 0.0,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     max_labels_count     = 500,
     max_lines_count      = 500)

// ─── INPUTS (locked defaults — see header table before changing) ────────
grpTrend  = "── Trend Filter ──"
htfTF     = input.timeframe("240", "Higher-TF Trend (4H)", group=grpTrend)
ema20Len  = input.int(20, "EMA20 Length (pullback zone)", group=grpTrend)
ema50Len  = input.int(50, "HTF EMA50", group=grpTrend)
ema200Len = input.int(200,"HTF EMA200", group=grpTrend)

grpPattern= "── Pattern Quality ──"
wickRatio = input.float(0.60, "Wick Ratio (0.70 SPX500/US30, 0.60 NAS100, 0.75 XAUUSD)",
                         minval=0.5, maxval=0.85, step=0.01, group=grpPattern)
touchTolATR = input.float(0.25, "Pullback Touch Tolerance (×ATR)", group=grpPattern)
extTolATR   = input.float(1.5,  "Not-Extended Tolerance (×ATR)",   group=grpPattern)

grpRisk   = "── Risk / Exit (locked shape) ──"
atrLen       = input.int(14, "ATR Length", group=grpRisk)
stopBufferATR= input.float(0.10, "Stop Buffer (×ATR)", group=grpRisk)
tp1R         = input.float(2.0, "TP1 (R multiple)", group=grpRisk)
tp2R         = input.float(4.0, "TP2 (R multiple, runner)", group=grpRisk)
tp1ClosePct  = input.float(50,  "% Closed at TP1 (rest -> BE, runs to TP2)", minval=0, maxval=100, group=grpRisk)
fillWindow   = input.int(3,  "Entry Fill Window (bars)", group=grpRisk)
timeStopBars = input.int(40, "Time-Stop (bars, ~1 week on 1H)", group=grpRisk)
riskPct      = input.float(1.0, "Risk % per Trade", minval=0.1, maxval=5, step=0.1, group=grpRisk)

grpViz    = "── Visuals ──"
showLabels = input.bool(true, "Show Entry/SL/TP Labels", group=grpViz)
showLevels = input.bool(true, "Show SL/TP Lines While Trade Is Open", group=grpViz)

// ─── HTF TREND BIAS (4H EMA50 vs EMA200, no repaint) ─────────────────────
htfClose = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_off)
htfEma50 = request.security(syminfo.tickerid, htfTF, ta.ema(close, ema50Len)[1], lookahead=barmerge.lookahead_off)
htfEma200= request.security(syminfo.tickerid, htfTF, ta.ema(close, ema200Len)[1], lookahead=barmerge.lookahead_off)

longBias  = htfEma50 > htfEma200 and htfClose > htfEma50
shortBias = htfEma50 < htfEma200 and htfClose < htfEma50
bias = longBias ? 1 : shortBias ? -1 : 0

// ─── CHART-TF INDICATORS ──────────────────────────────────────────────────
ema20 = ta.ema(close, ema20Len)
atr   = ta.atr(atrLen)

// ─── PATTERN DETECTION ────────────────────────────────────────────────────
bullPin(o, h, l, c) =>
    rng = h - l
    body = math.abs(c - o)
    lowerWick = math.min(o, c) - l
    rng > 0 and lowerWick >= wickRatio * rng and body <= (0.95 - wickRatio) * rng and (c - l) >= wickRatio * rng

bearPin(o, h, l, c) =>
    rng = h - l
    body = math.abs(c - o)
    upperWick = h - math.max(o, c)
    rng > 0 and upperWick >= wickRatio * rng and body <= (0.95 - wickRatio) * rng and (h - c) >= wickRatio * rng

bullEngulf(po, pc, o, c) => pc < po and c > o and o <= pc and c >= po
bearEngulf(po, pc, o, c) => pc > po and c < o and o >= pc and c <= po

// ─── SIGNAL CONDITIONS (mirrors generate_signals() exactly) ──────────────
notExtended = math.abs(close - ema20) <= extTolATR * atr

longTouched  = (low  - touchTolATR * atr) <= ema20
shortTouched = (high + touchTolATR * atr) >= ema20

longPattern  = bullPin(open, high, low, close) or bullEngulf(open[1], close[1], open, close)
shortPattern = bearPin(open, high, low, close) or bearEngulf(open[1], close[1], open, close)

longSignal  = bias == 1  and notExtended and longTouched  and longPattern
shortSignal = bias == -1 and notExtended and shortTouched and shortPattern

// ─── PLOT BUY/SELL MARKERS (the "print buy/sell on chart" part) ──────────
plotshape(longSignal,  title="BUY signal",  style=shape.triangleup,   location=location.belowbar,
     color=color.new(color.lime, 0), size=size.small, text="BUY")
plotshape(shortSignal, title="SELL signal", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="SELL")

plot(ema20, "EMA20 (pullback zone)", color=color.new(color.orange, 40))
bgcolor(bias == 1 ? color.new(color.green, 92) : bias == -1 ? color.new(color.red, 92) : na, title="4H bias")

// ─── ENTRY / STOP / TARGETS (matches simulate() honest-fill logic) ──────
var float pendingEntry = na
var float pendingStop  = na
var int   pendingDir   = 0
var int   pendingBar   = na

if longSignal and strategy.position_size == 0 and na(pendingEntry)
    pendingEntry := high + syminfo.mintick
    pendingStop  := math.min(low, low[1]) - stopBufferATR * atr
    pendingDir   := 1
    pendingBar   := bar_index

if shortSignal and strategy.position_size == 0 and na(pendingEntry)
    pendingEntry := low - syminfo.mintick
    pendingStop  := math.max(high, high[1]) + stopBufferATR * atr
    pendingDir   := -1
    pendingBar   := bar_index

// cancel a pending stop order if it hasn't filled within the honest fill window
if not na(pendingBar) and strategy.position_size == 0 and (bar_index - pendingBar) > fillWindow
    strategy.cancel("Long")
    strategy.cancel("Short")
    pendingEntry := na
    pendingStop  := na
    pendingDir   := 0
    pendingBar   := na

float riskUnit = na(pendingEntry) ? float(na) : math.abs(pendingEntry - pendingStop)
float qty = na(riskUnit) or riskUnit <= 0 ? float(na) : (strategy.equity * riskPct / 100) / riskUnit

if pendingDir == 1 and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=qty, stop=pendingEntry)
if pendingDir == -1 and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=qty, stop=pendingEntry)

var float entryPrice = na
var float slPrice    = na
var float tp1Price   = na
var float tp2Price   = na
var int   entryBar   = na
var bool  tp1Hit      = false

if strategy.position_size != 0 and na(entryPrice)
    entryPrice := strategy.position_avg_price
    slPrice    := pendingStop
    dir        = strategy.position_size > 0 ? 1 : -1
    tp1Price   := entryPrice + dir * tp1R * riskUnit
    tp2Price   := entryPrice + dir * tp2R * riskUnit
    entryBar   := bar_index
    tp1Hit     := false
    pendingEntry := na
    pendingStop  := na
    pendingDir   := 0
    pendingBar   := na

if strategy.position_size != 0
    strategy.exit("TP1", from_entry=strategy.position_size > 0 ? "Long" : "Short",
         qty_percent=tp1ClosePct, limit=tp1Price, stop=slPrice)
    beStop = tp1Hit ? entryPrice : slPrice
    strategy.exit("TP2", from_entry=strategy.position_size > 0 ? "Long" : "Short",
         limit=tp2Price, stop=beStop)
    if not na(entryBar) and (bar_index - entryBar) >= timeStopBars
        strategy.close_all(comment="time-stop")

// detect TP1 fill (rough: position size dropped but didn't go flat) to arm breakeven
var float lastQty = 0.0
if strategy.position_size != 0 and math.abs(strategy.position_size) < math.abs(lastQty) and not tp1Hit
    tp1Hit := true
lastQty := strategy.position_size

if strategy.position_size == 0
    entryPrice := na
    slPrice    := na
    tp1Price   := na
    tp2Price   := na
    entryBar   := na
    tp1Hit     := false

// ─── LABELS + LEVEL LINES ─────────────────────────────────────────────────
if showLabels and (longSignal or shortSignal)
    label.new(bar_index, longSignal ? low - atr : high + atr,
         longSignal ? "BUY\nE " + str.tostring(math.round(high, 5)) : "SELL\nE " + str.tostring(math.round(low, 5)),
         style=longSignal ? label.style_label_up : label.style_label_down,
         color=longSignal ? color.new(color.lime, 20) : color.new(color.red, 20),
         textcolor=color.white, size=size.small)

var line slLine  = na
var line tp1Line = na
var line tp2Line = na
if showLevels
    if not na(entryPrice)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        slLine  := line.new(entryBar, slPrice,  bar_index, slPrice,  color=color.new(color.red, 0),   style=line.style_dashed)
        tp1Line := line.new(entryBar, tp1Price, bar_index, tp1Price, color=color.new(color.lime, 0),  style=line.style_dotted)
        tp2Line := line.new(entryBar, tp2Price, bar_index, tp2Price, color=color.new(color.blue, 0),  style=line.style_dashed)
    else
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)

// ─── DASHBOARD ─────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Bias",    text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(dash, 1, 0, bias == 1 ? "LONG" : bias == -1 ? "SHORT" : "NONE",
         text_color=bias == 1 ? color.lime : bias == -1 ? color.red : color.gray)
    table.cell(dash, 0, 1, "Trades",  text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(dash, 1, 1, str.tostring(strategy.closedtrades), text_color=color.white)
    winTrades = strategy.wintrades
    totTrades = strategy.closedtrades
    wr = totTrades > 0 ? (winTrades / totTrades) * 100 : 0
    table.cell(dash, 0, 2, "Win Rate", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(dash, 1, 2, str.tostring(math.round(wr, 1)) + "%", text_color=color.white)
    pf = strategy.grossprofit / (strategy.grossloss == 0 ? 1 : strategy.grossloss)
    table.cell(dash, 0, 3, "Profit Factor", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(dash, 1, 3, str.tostring(math.round(pf, 2)), text_color=color.white)
