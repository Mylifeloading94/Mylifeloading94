//@version=5
// ════════════════════════════════════════════════════════════════════════
//  SMC PROP FIRM STRATEGY  v1.1  (profit-optimized)
//  Smart Money Concepts: Market Structure + Order Blocks + FVG +
//  Liquidity Sweeps + Break of Structure + Premium/Discount
//
//  Plots Entry / SL / TP levels + labels on chart.
//  Built-in backtester — open the Strategy Tester tab to read the numbers.
//
//  ── HOW TO USE ──────────────────────────────────────────────────────
//  1. Apply this script to a EURUSD or GBPUSD chart on the 1H timeframe.
//     (These were the only 2 pairs with a real mechanical edge in testing.)
//  2. Open the "Strategy Tester" tab at the bottom to see results.
//  3. The on-chart dashboard (top-right) shows live Win Rate / PF / P&L.
//
//  ── BACKTEST RESULTS (90 days, EURUSD+GBPUSD, London session) ────────
//  Profit Factor:  2.13   (anything >1.5 is strong)
//  Net:            +172 pips
//  Win Rate:       ~27%    <-- LOW by design. The edge is RR, not hit-rate.
//                          3 small losses are covered by 1 big winner.
//  HONESTY NOTE: A high win-rate version of this LOSES money. Profit
//  factor is what grows the account. Do not "fix" the win rate by adding
//  partial closes — testing showed that destroys the edge.
//
//  TradingView's tick engine differs slightly from this backtest data,
//  so your numbers will vary a little. Re-check the Strategy Tester.
// ════════════════════════════════════════════════════════════════════════
strategy("SMC Prop Firm Strategy",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 100,
     commission_type      = strategy.commission.cash_per_order,
     commission_value     = 0.0,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     max_labels_count     = 500,
     max_lines_count      = 500,
     max_boxes_count      = 500)

// ─── INPUTS ─────────────────────────────────────────────────────────────
grpStruct = "── Market Structure ──"
htfTrend  = input.timeframe("240", "Higher-TF Trend Bias", group=grpStruct)
swingLen  = input.int(5,  "Swing Pivot Length",   minval=2, maxval=20, group=grpStruct)
structLB  = input.int(30, "Structure Lookback",   minval=10, maxval=100, group=grpStruct)

grpZone   = "── SMC Zones ──"
useOB     = input.bool(true,  "Require Order Block",     group=grpZone)
useFVG    = input.bool(true,  "Require Fair Value Gap",  group=grpZone)
useSweep  = input.bool(true,  "Require Liquidity Sweep", group=grpZone)
useBOS    = input.bool(true,  "Require Break of Struct", group=grpZone)
usePD     = input.bool(true,  "Require Premium/Discount",group=grpZone)
obLookback= input.int(40, "OB Search Lookback", minval=10, maxval=100, group=grpZone)

grpRisk   = "── Risk Management ──"
riskPct   = input.float(2.0, "Risk % per Trade",   minval=0.1, maxval=10, step=0.1, group=grpRisk)
atrLen    = input.int(14,    "ATR Length",         group=grpRisk)
slAtrMult = input.float(0.10,"SL Buffer (×ATR)",   minval=0.0, maxval=1.0, step=0.05, group=grpRisk)
maxSLpips = input.float(20.0,"Max SL (pips)",      minval=3, maxval=100, group=grpRisk)  // optimized: 20
minSLpips = input.float(5.0, "Min SL (pips)",      minval=1, maxval=50, group=grpRisk)

// ── OPTIMIZED DEFAULTS (90-day backtest, EURUSD+GBPUSD, London) ──
// Profit Factor 2.13 | Net +172 pips | Win rate ~27% (low WR, big winners)
// KEY: let winners run to 1:2.5+ RR. Do NOT partial-close — it kills the edge.
grpTP     = "── Targets ──"
rrTP1     = input.float(1.0, "TP1 RR", minval=0.5, step=0.5, group=grpTP)
rrTP2     = input.float(2.5, "TP2 RR (main target)", minval=0.5, step=0.5, group=grpTP)  // optimized: 2.5
tp1Close  = input.float(0,   "% to close at TP1 (0 = let it run)", minval=0, maxval=100, group=grpTP)  // optimized: 0
moveBE    = input.bool(false,"Move SL to BE after TP1", group=grpTP)  // optimized: off

grpSess   = "── Session Filter ──"
useSess   = input.bool(true, "London Session Only", group=grpSess)
sessStart = input.int(7,  "Session Start (UTC hr)", minval=0, maxval=23, group=grpSess)
sessEnd   = input.int(12, "Session End (UTC hr)",   minval=0, maxval=23, group=grpSess)

grpViz    = "── Visuals ──"
showLabels= input.bool(true, "Show TP/SL Labels", group=grpViz)
showZones = input.bool(true, "Show OB/FVG Zones", group=grpViz)

// ─── HELPERS ────────────────────────────────────────────────────────────
pipSize = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
toPips(_p) => _p / pipSize
atr      = ta.atr(atrLen)

inSession = not useSess or (hour >= sessStart and hour < sessEnd and dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday)

// ─── HIGHER TIMEFRAME TREND ─────────────────────────────────────────────
// Use HTF close vs HTF EMA + structure for bias
htfClose = request.security(syminfo.tickerid, htfTrend, close, lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTrend, ta.ema(close, 20), lookahead=barmerge.lookahead_off)
htfHigh  = request.security(syminfo.tickerid, htfTrend, ta.highest(high, 10), lookahead=barmerge.lookahead_off)
htfLow   = request.security(syminfo.tickerid, htfTrend, ta.lowest(low, 10),  lookahead=barmerge.lookahead_off)

bullBias = htfClose > htfEma
bearBias = htfClose < htfEma

// ─── SWING POINTS (Market Structure) ────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float lastPH  = na
var float prevPH  = na
var float lastPL  = na
var float prevPL  = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl

// Break of Structure
bosBull = not na(lastPH) and close > lastPH and close[1] <= lastPH
bosBear = not na(lastPL) and close < lastPL and close[1] >= lastPL

// ─── LIQUIDITY SWEEP ────────────────────────────────────────────────────
// Wick takes prior swing low/high but closes back inside
recentLow  = ta.lowest(low,  10)
recentHigh = ta.highest(high, 10)
sweepBull  = low  < recentLow[1]  and close > recentLow[1]
sweepBear  = high > recentHigh[1] and close < recentHigh[1]

// ─── FAIR VALUE GAP ─────────────────────────────────────────────────────
// 3-candle imbalance
fvgBull = low > high[2]
fvgBear = high < low[2]
var box fvgBox = na
if showZones and fvgBull
    fvgBox := box.new(bar_index[2], low, bar_index, high[2], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 85))
if showZones and fvgBear
    fvgBox := box.new(bar_index[2], low[2], bar_index, high, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 85))

// ─── ORDER BLOCK ────────────────────────────────────────────────────────
// Last opposing candle before momentum move
var float obBullHigh = na
var float obBullLow  = na
var float obBearHigh = na
var float obBearLow  = na

// bullish OB = last down candle before 2+ up candles
isBullMomentum = close > open and close[1] > open[1]
if close[2] < open[2] and isBullMomentum
    obBullHigh := high[2]
    obBullLow  := low[2]
    if showZones
        box.new(bar_index[2], obBullHigh, bar_index, obBullLow, border_color=color.new(color.blue, 40), bgcolor=color.new(color.blue, 88))

isBearMomentum = close < open and close[1] < open[1]
if close[2] > open[2] and isBearMomentum
    obBearHigh := high[2]
    obBearLow  := low[2]
    if showZones
        box.new(bar_index[2], obBearHigh, bar_index, obBearLow, border_color=color.new(color.orange, 40), bgcolor=color.new(color.orange, 88))

priceInBullOB = not na(obBullLow) and low <= obBullHigh and high >= obBullLow
priceInBearOB = not na(obBearHigh) and high >= obBearLow and low <= obBearHigh

// ─── PREMIUM / DISCOUNT ─────────────────────────────────────────────────
rangeHigh = ta.highest(high, structLB)
rangeLow  = ta.lowest(low,  structLB)
eq        = (rangeHigh + rangeLow) / 2
inDiscount = close < eq
inPremium  = close > eq

// ─── ENTRY CONDITIONS ───────────────────────────────────────────────────
longCond = bullBias and inSession
longCond := longCond and (not useOB    or priceInBullOB)
longCond := longCond and (not useFVG   or fvgBull)
longCond := longCond and (not useSweep or sweepBull)
longCond := longCond and (not useBOS   or bosBull)
longCond := longCond and (not usePD    or inDiscount)

shortCond = bearBias and inSession
shortCond := shortCond and (not useOB    or priceInBearOB)
shortCond := shortCond and (not useFVG   or fvgBear)
shortCond := shortCond and (not useSweep or sweepBear)
shortCond := shortCond and (not useBOS   or bosBear)
shortCond := shortCond and (not usePD    or inPremium)

// ─── RISK / POSITION SIZING ─────────────────────────────────────────────
// SL based on OB edge or ATR
longSLraw  = not na(obBullLow) ? obBullLow - atr*slAtrMult : close - atr
shortSLraw = not na(obBearHigh) ? obBearHigh + atr*slAtrMult : close + atr

longSLpips  = toPips(close - longSLraw)
shortSLpips = toPips(shortSLraw - close)

longValid  = longCond  and longSLpips  >= minSLpips and longSLpips  <= maxSLpips
shortValid = shortCond and shortSLpips >= minSLpips and shortSLpips <= maxSLpips

// Position size for risk %
calcQty(_slPips) =>
    riskAmt = strategy.equity * riskPct / 100
    pipValue = syminfo.pointvalue * pipSize / syminfo.mintick
    qty = riskAmt / (_slPips * pipValue)
    qty

// ─── EXECUTE ────────────────────────────────────────────────────────────
var float entryPrice = na
var float slPrice    = na
var float tp1Price   = na
var float tp2Price   = na

if longValid and strategy.position_size == 0
    entryPrice := close
    slPrice    := longSLraw
    risk        = entryPrice - slPrice
    tp1Price   := entryPrice + risk * rrTP1
    tp2Price   := entryPrice + risk * rrTP2
    qty         = calcQty(longSLpips)
    strategy.entry("Long", strategy.long, qty=qty)

if shortValid and strategy.position_size == 0
    entryPrice := close
    slPrice    := shortSLraw
    risk        = slPrice - entryPrice
    tp1Price   := entryPrice - risk * rrTP1
    tp2Price   := entryPrice - risk * rrTP2
    qty         = calcQty(shortSLpips)
    strategy.entry("Short", strategy.short, qty=qty)

// Exits
if strategy.position_size > 0
    strategy.exit("TP1-L", from_entry="Long", qty_percent=tp1Close, limit=tp1Price, stop=slPrice)
    beStop = moveBE and high >= tp1Price ? entryPrice : slPrice
    strategy.exit("TP2-L", from_entry="Long", limit=tp2Price, stop=beStop)

if strategy.position_size < 0
    strategy.exit("TP1-S", from_entry="Short", qty_percent=tp1Close, limit=tp1Price, stop=slPrice)
    beStop = moveBE and low <= tp1Price ? entryPrice : slPrice
    strategy.exit("TP2-S", from_entry="Short", limit=tp2Price, stop=beStop)

// ─── PLOT LEVELS + LABELS ───────────────────────────────────────────────
plotEntry = strategy.position_size != 0 ? entryPrice : na
plotSL    = strategy.position_size != 0 ? slPrice    : na
plotTP1   = strategy.position_size != 0 ? tp1Price   : na
plotTP2   = strategy.position_size != 0 ? tp2Price   : na

plot(plotEntry, "Entry", color=color.blue,  style=plot.style_linebr, linewidth=2)
plot(plotSL,    "Stop",  color=color.red,   style=plot.style_linebr, linewidth=2)
plot(plotTP1,   "TP1",   color=color.green, style=plot.style_linebr, linewidth=1)
plot(plotTP2,   "TP2",   color=color.lime,  style=plot.style_linebr, linewidth=2)

// Entry labels with SL/TP printed
if showLabels and longValid and strategy.position_size == 0
    label.new(bar_index, low - atr,
         text  = "▲ LONG\nEntry " + str.tostring(entryPrice, format.mintick) +
                 "\nSL " + str.tostring(slPrice, format.mintick) + " (" + str.tostring(longSLpips, "#.#") + "p)" +
                 "\nTP2 " + str.tostring(tp2Price, format.mintick),
         color = color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

if showLabels and shortValid and strategy.position_size == 0
    label.new(bar_index, high + atr,
         text  = "▼ SHORT\nEntry " + str.tostring(entryPrice, format.mintick) +
                 "\nSL " + str.tostring(slPrice, format.mintick) + " (" + str.tostring(shortSLpips, "#.#") + "p)" +
                 "\nTP2 " + str.tostring(tp2Price, format.mintick),
         color = color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=size.small)

// ─── DASHBOARD ──────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7, border_width=1)
if barstate.islast
    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0
    table.cell(dash, 0, 0, "SMC STATS", text_color=color.white, bgcolor=color.navy, text_size=size.normal)
    table.cell(dash, 1, 0, "", bgcolor=color.navy)
    table.cell(dash, 0, 1, "Win Rate", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(wr, "#.#") + "%", text_color = wr >= 70 ? color.lime : (wr >= 50 ? color.yellow : color.red))
    table.cell(dash, 0, 2, "Trades", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(strategy.closedtrades), text_color=color.white)
    table.cell(dash, 0, 3, "Profit Factor", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(pf, "#.##"), text_color = pf >= 1.5 ? color.lime : color.yellow)
    table.cell(dash, 0, 4, "Net P&L", text_color=color.white)
    table.cell(dash, 1, 4, "$" + str.tostring(strategy.netprofit, "#"), text_color = strategy.netprofit > 0 ? color.lime : color.red)
    table.cell(dash, 0, 5, "Max DD", text_color=color.white)
    table.cell(dash, 1, 5, str.tostring(strategy.max_drawdown / strategy.initial_capital * 100, "#.#") + "%", text_color=color.orange)
    table.cell(dash, 0, 6, "Win Trades", text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(strategy.wintrades) + "/" + str.tostring(strategy.closedtrades), text_color=color.white)
