TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MARKET_DATA_API_KEY=
NEWS_API_KEY=
X_API_KEY=
DATABASE_URL=

# --- Optional ---------------------------------------------------------
# Force DEMO mode even if a market data key is present (true/false)
DEMO_MODE=
# Secret token Telegram sends back on webhook calls (set the same value via `npm run telegram:webhook`)
TELEGRAM_WEBHOOK_SECRET=
# Public https URL of this app, used only by scripts/set-webhook.mjs
PUBLIC_APP_URL=
# Server-side auto-scan interval in seconds (0 / empty = manual scans only)
SCAN_INTERVAL_SECONDS=
# Where the file-based fallback database lives when DATABASE_URL is empty
DATA_DIR=.data
